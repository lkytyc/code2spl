# Credentials.  `code/.env.example` documents every setting; `code/.env` holds
# the values and must never be committed.
.env
code/.env

# Scratch the harness creates on a run: model caches, repository checkouts,
# temporary sources.  `spl/` holds the Experiment 3 SPL snapshot the prepare
# stage assembles from the frozen assets in `data/RQ3/spl_assets/`.
work/
spl/

# Byte-compiled files and tool caches.
__pycache__/
*.py[cod]
.pytest_cache/
