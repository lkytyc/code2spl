# ─────────────────────────────────────────────────────────────────────────────
#  SPL reproducibility package — environment
#
#  Copy this file to `.env` in the package root and fill in the values:
#
#      cp .env.example .env
#
#  `code/common/env.py` reads it at startup and puts every entry into the
#  process environment.  A variable already set in your shell wins over the
#  file, so you can always override one run from the command line:
#
#      OPENAI_BASE_URL=https://my-gateway/v1 python code/RQ3/run.py ...
#
#  `.env` holds credentials and therefore must never be committed; the package
#  `.gitignore` excludes it.
#
#  Nothing below changes what the experiments measured.  The shipped configs
#  under `data/*/settings/` name their own model, endpoint, temperature and
#  token budget, and those records are what the paper reports.  What you supply
#  here is *access*: which endpoint to reach, and with which key.  Section 5
#  lists the config keys to edit if you want to substitute a different model.
# ─────────────────────────────────────────────────────────────────────────────


# ── 1. Credentials ───────────────────────────────────────────────────────────
# Every stage talks to an OpenAI-compatible endpoint.  One key is enough.
# Neither value is ever printed by the harness; the key goes straight to the
# HTTP client.

OPENAI_API_KEY=
# For parallel runs: several keys, comma / semicolon / newline separated.
# Concurrent requests are spread across them, up to MAX_PER_KEY each.
OPENAI_API_KEYS=

# The endpoint the runs were made against.  Leave blank for the OpenAI default
# (https://api.openai.com/v1).  A config that names its own `base_url` overrides
# this; the three endpoints the experiments actually used are:
#
#     https://api.deepseek.com              deepseek-v4-pro, deepseek-v4-flash
#     <OpenAI-compatible gateway>/v1        claude-opus-5, gpt-5.4,
#                                           gpt-5.4-mini,
#                                           deepseek-v4-flash-0731
#     https://api.scnet.cn/api/llm/v1       DeepSeek-V4-Pro (80-step arm)
#
# The three Claude and GPT runs went through a hosted OpenAI-compatible
# gateway; its host is left out here because it names the authors' account.
# Any gateway that serves those models under the same names works.
#
# The configs for those runs therefore ship with `"base_url": null`, which means
# "take the endpoint from this file".  The DeepSeek configs name their public
# endpoint themselves and need no setting here.  If you point a Claude or GPT
# config at your own gateway, `OPENAI_BASE_URL` (task calls) and `SPL_BASE_URL`
# (SPL-building calls) are what it reads.
#
# To repoint every run at a single gateway of your own, set the next two.
# They act as a fallback only: anything the config states explicitly still wins.
OPENAI_BASE_URL=
SPL_BASE_URL=
SPL_API_KEY=


# ── 2. Where the package lives ───────────────────────────────────────────────
# Paths in the shipped configs are written as `$PROJECT_ROOT/...` and expanded
# against the package root (`code/common/env.py`).  Leave blank unless you moved
# the package after unpacking it.
SPL_PROJECT_ROOT=


# ── 3. SPL construction — once per repository ────────────────────────────────
# SPL is built ahead of time, one run per repository, and every task against
# that repository then reads the artifact.  The frozen artifacts shipped under
# `data/*/spl_assets/` are the ones the reported runs consumed, so you do not
# need this stage at all unless you extend the study to new repositories.
#
# Builder model used per experiment (paragraph 5 of README.md explains the two
# stages):
#
#     RQ1  the model under test builds its own SPL — the builder column of the
#          RQ1 table is the same as the task column.
#     RQ2  deepseek-v4-flash
#     RQ3  deepseek-v4-flash
#
# These are read only by SPL-building entry points; they never override a
# frozen artifact.

SPL_BUILDER_MODEL=
SPL_BUILDER_BASE_URL=
SPL_BUILDER_API_KEY=
SPL_BUILDER_TEMPERATURE=0.0
SPL_BUILDER_MAX_OUTPUT_TOKENS=


# ── 4. Task inference — the stage the experiments measure ────────────────────
# One call (RQ1, RQ2) or one agent trajectory (RQ3) per task, identical across
# conditions apart from the SPL layer.  Nothing here changes a shipped
# config — it is what a *new* run started from the defaults would use.

SPL_TASK_MODEL=
SPL_TASK_BASE_URL=
SPL_TASK_API_KEY=
SPL_TASK_TEMPERATURE=0.0
SPL_TASK_MAX_OUTPUT_TOKENS=


# ── 5. Values the shipped configs record ─────────────────────────────────────
# Reproduced here so you can see what the runs used without opening 46 files.
# To substitute a model, edit the config file named in the last column; the
# harness takes these from the config, never from the environment.
#
#   Experiment          Stage    Model                  temperature  cap     config
#   ─────────────────── ──────── ────────────────────── ──────────── ─────── ──────────────────────────────────
#   RQ1 ClassEval       task     claude-opus-5          0.0          4096    full100_claude-opus-5.json
#   RQ1 ClassEval       task     gpt-5.4                0.0          4096    full100_gpt-5.4.json
#   RQ1 ClassEval       task     gpt-5.4-mini           0.0          4096    full100_gpt-5.4-mini.json
#   RQ1 ClassEval       task     deepseek-v4-pro        0.0          4096    full100_deepseek-v4-pro.json
#   RQ1 ClassEval       task     deepseek-v4-flash      0.0          4096    full100_deepseek-v4-flash.json
#   RQ1 ClassEval       task     deepseek-v4-flash-0731 0.0          4096    full100_deepseek-v4-flash_spl_structure_ablation.json
#   RQ2 core reasoning  builder  deepseek-v4-flash      —            —       full341_deepseek-v4-pro.json
#   RQ2 core reasoning  task     deepseek-v4-pro        0.0          16384   full341_deepseek-v4-pro.json
#   RQ3 SWE-bench Lite  builder  deepseek-v4-flash      —            —       paper_base_config.json
#   RQ3 SWE-bench Lite  task     deepseek-v4-pro        0            8192    paper_base_config.json
#   RQ3 80-step arm     task     DeepSeek-V4-Pro        0            8192    configs/budget_relaxation_80step_stratified30/generation_main_five.json
#
# RQ1's structure ablation re-runs two conditions with the tags removed, on the
# same content and the same model — see `full100_*_spl_structure_ablation.json`.


# ── 6. Runtime ───────────────────────────────────────────────────────────────
# Concurrency and retry knobs.  The shipped configs set their own; these are
# the fallbacks for a config that leaves them out.
#
#   SPL_MAX_WORKERS         concurrent tasks per run
#   SPL_PREPARE_MAX_WORKERS concurrent tasks while preparing inputs
#   SPL_MAX_PER_KEY         concurrent requests allowed per API key
#   SPL_MAX_RETRIES         retries per request before the run records a failure
#   SPL_TIMEOUT_SECONDS     per-request timeout

SPL_MAX_WORKERS=
SPL_PREPARE_MAX_WORKERS=
SPL_MAX_PER_KEY=
SPL_MAX_RETRIES=
SPL_TIMEOUT_SECONDS=


# ── 7. Notes for RQ3 ─────────────────────────────────────────────────────────
# RQ3 runs the SWE-bench Lite harness, which executes every instance inside its
# own Docker image.  Two things must hold before a re-run:
#
#   * Docker is running and can pull `swebench/sweb.eval.x86_64.*` images.
#     The instances and their images are listed in
#     `data/RQ3/inputs/unit_manifests_random218/`.
#   * On Windows the repository checkouts use long paths.  Enable long-path
#     support (`git config --system core.longpaths true`) or the harness will
#     fail to check out some instances.  The package's own file reading already
#     goes through the `\\?\` prefix where needed (`code/common/paths.py`).
#
# The 218 instances are held fixed across every arm; the sampled IDs are in
# `data/RQ3/inputs/unit_manifests_random218/`.
